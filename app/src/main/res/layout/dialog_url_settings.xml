<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="E Shop System Settings"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter or update the target Web Application URL for this device:"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etUrlInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="https://admin-14.hoteleshopdemo.com/"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_subtle"
        android:textSize="15sp" />

    <!-- Test Local Notification Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTestNotification"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:text="🔔 Test Phone Notification &amp; Sound"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <!-- Fetch & Display FCM Token Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFetchFcmToken"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:text="🔑 Fetch &amp; Display Google FCM Token"
        android:textColor="#f59e0b"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/tvFcmTokenDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:padding="10dp"
        android:text="FCM Token: (Click Fetch button above)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Register Device in Database Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRegisterDeviceDb"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_button"
        android:text="📱 Save FCM Token to Database"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelUrl"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_muted"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveUrl"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_gradient_button"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="Save &amp; Connect"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
